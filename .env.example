# Schwab API credentials
SCHWAB_API_KEY= replace
SCHWAB_APP_SECRET= replace
SCHWAB_TOKEN_PATH=schwab_token.json

# Telegram alerts (get from @BotFather)
TELEGRAM_BOT_TOKEN= replace
TELEGRAM_CHAT_ID= replace

# Reddit API (for social signal)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=arconian/0.1

# Optional: Alpha Vantage (earnings calendar cross-reference)
ALPHA_VANTAGE_API_KEY=

# Optional: Norgate (Windows only, requires NDU running)
# No key needed — license is validated by the NDU process

# Database path (default: arconian.db in project root)
DB_PATH=arconian.db
